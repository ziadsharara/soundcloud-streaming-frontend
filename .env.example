# Local Docker/nginx can proxy this same-origin path. On Vercel, set the full
# public HTTPS backend URL, including /api (for example https://api.example.com/api).
VITE_API_BASE_URL=/api

# Optional. By default this becomes wss://<API host>/ws.
# Set it when the WebSocket is served from a different public endpoint.
VITE_WS_URL=


# Optional. Voice notes, video notes and files go straight to the backend rather than through
# the site's own /api path, which on a hosting edge is a poor road for a large upload.
# Defaults to the backend behind VITE_WS_URL, then to VITE_API_BASE_URL.
VITE_UPLOAD_BASE_URL=
