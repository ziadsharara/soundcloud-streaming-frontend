# Local Docker/nginx can proxy this same-origin path. On Vercel, set the full
# public HTTPS backend URL, including /api (for example https://api.example.com/api).
VITE_API_BASE_URL=/api

# Optional. By default this becomes wss://<API host>/ws.
# Set it when the WebSocket is served from a different public endpoint.
VITE_WS_URL=

# Optional, host-only: lets the host browse their own Spotify playlists and likes.
# Register a free app at developer.spotify.com, add <origin>/spotify/callback as a
# redirect URI, and allow-list each account (development mode permits five Premium users).
VITE_SPOTIFY_CLIENT_ID=
